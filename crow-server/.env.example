# Bind only to loopback; Caddy exposes HTTPS on ports 80/443.
CROW_ADDR=127.0.0.1:8090
CROW_DATA_DIR=/opt/crow-server/data

# Admin account. Generate a hash with: ./crow-server hash-password
ADMIN_USERNAME=Admin
ADMIN_PASSWORD_HASH=

# Long, obscure URL path. You may replace this with your own random path.
ADMIN_PATH=/jsjxjdkdl/jskdksld
